{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Form Forge",
  "version": "0.2.1",
  "identifier": "com.form-forge.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Form Forge",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCQzU0NTU2RkNDMzM4QQpSV1NLTTh4dlZWUzhCUFNkTTNuZ3ZUTk96VjZkc3o2VTRkNzBlWHlOa2tzVm1tTTVlYWJHM2FSbgo=",
      "endpoints": [
        "https://github.com/maikbasel/form-forge/releases/latest/download/latest.json"
      ]
    }
  }
}
